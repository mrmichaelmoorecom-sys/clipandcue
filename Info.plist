<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>clipandcue</string>
    <key>CFBundleDisplayName</key>
    <string>clipandcue</string>
    <key>CFBundleIdentifier</key>
    <string>com.clipandcue.app</string>
    <key>CFBundleExecutable</key>
    <string>clipandcue</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.14</string>
    <key>CFBundleVersion</key>
    <string>31</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>clipandcue — freeware clipboard history utility.</string>
    <!-- App Store export-compliance: clipandcue only uses system-provided
         encryption (HTTPS via CloudKit, Keychain access). No custom crypto.
         Declaring this here means App Store Connect skips the
         App Encryption Documentation prompt on every submission. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Required by App Store ingestion (Transporter validation 409) —
         must be a UTI from the public.app-category.* namespace.
         Productivity matches what we list on the App Store Connect page. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.clipandcue.clip-id</string>
            <key>UTTypeDescription</key>
            <string>clipandcue clip reference</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict/>
        </dict>
    </array>
</dict>
</plist>
