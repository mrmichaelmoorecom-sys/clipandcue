<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by macOS 26+ when an embedded provisioning profile is present:
         the kernel's AppleSystemPolicy binds the binary to the profile via these
         two keys, and refuses to exec the binary at all when they're missing.
         Match the profile's app identifier and team prefix exactly. -->
    <key>com.apple.application-identifier</key>
    <string>HA5AB7JS87.com.clipandcue.app</string>
    <key>com.apple.developer.team-identifier</key>
    <string>HA5AB7JS87</string>

    <!-- Allow sending Apple events (Notes "New note") under the hardened runtime. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- CloudKit sync with the iPhone app (shared private-database container). -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.clipandcue.shared</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- Receive silent CloudKit pushes for live sync (Developer ID → production APNs).
         NOTE: macOS uses the com.apple.developer-prefixed key; the bare
         `aps-environment` key is iOS-only and, on macOS, is treated as an
         unauthorized restricted entitlement → "Launchd job spawn failed" at
         launch. Must match the key the provisioning profile authorizes. -->
    <key>com.apple.developer.aps-environment</key>
    <string>production</string>
</dict>
</plist>
